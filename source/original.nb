              RowBox[{"{", 
               RowBox[{"a", ",", "0", ",", 
                RowBox[{"2", "\[Pi]"}], ",", 
                RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cent", "+", 
                  RowBox[{".98", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "@", "a"}], ",", 
                    RowBox[{"Sin", "@", "a"}]}], "}"}]}]}], ",", 
                 RowBox[{"cent", "+", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Cos", "@", "a"}], ",", 
                    RowBox[{"Sin", "@", "a"}]}], "}"}]}]}], "}"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"a", ",", 
