Cell[TextData[{
 "In a pinhole camera, light enters the camera through a tiny hole and \
illuminates the image plane. A pinhole camera has a focal length ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "f9ab691f-58a7-4e4f-b919-f536b10ef33d"],
 ", the distance from the pinhole to the image plane. The pinhole is shown \
with a blue point and the image plane as a blue line. 3D points in the \
camera's coordinate frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "c"], ",", 
      SubscriptBox["y", "c"], ",", 
      SubscriptBox["z", "c"]}], ")"}], "\[Transpose]"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"d0552c67-2b7d-4df4-bdd2-ec151d3df53d"],
 " are converted to image plane coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"u", ",", "v"}], ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"531117e9-4867-4e34-b0c5-484e25d00a32"],
 " according to the formula:"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6685114046880083`*^9, 3.668511490168091*^9}, {
   3.6685115706579113`*^9, 3.668511706959024*^9}, {3.676044237180941*^9, 
   3.676044280903822*^9}, 3.676046261869499*^9, {3.6760627692232323`*^9, 
   3.676062807185403*^9}, {3.676065937169553*^9, 3.676065940432332*^9}, {
   3.676065985239326*^9, 3.6760660194453707`*^9}, 3.676134463522851*^9},
 CellID->1532761035,ExpressionUUID->"508a691f-8da9-46be-a9c3-5b03c6027178"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", " ", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["x", "c"]},
        {GridBox[{
           {
            SubscriptBox["y", "c"]},
           {
            SubscriptBox["z", "c"]}
          }]}
       }], ")"}]}], "=", 
    RowBox[{"(", GridBox[{
       {"u"},
       {GridBox[{
          {"v"},
          {"\[Lambda]"}
         }]}
      }], ")"}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "7649f4ff-186c-4120-9d96-4917453a8405"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k",
     FontSlant->"Italic"], "=", 
    RowBox[{"\[Lambda]", "/", 
     SubscriptBox["z", "c"]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"cc14529d-8bf7-4f2c-8717-47b6c29b8438"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6685114046880083`*^9, 3.668511567648116*^9}, {
  3.6758980015988417`*^9, 3.675898042169466*^9}, {3.676044294943664*^9, 
  3.6760442956400633`*^9}, {3.676062815429297*^9, 3.676062891174852*^9}},
 CellID->1663998529,ExpressionUUID->"65ae9d3a-d0ec-468a-b4f9-885afa67d3d1"],

Cell[TextData[{
 "All lines parallel to the camera frame's ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "df5ed10b-7c56-4fb9-a74a-2062c77e7c7d"],
 " axis terminate at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "\[Infinity]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"7f9b393f-45c3-4118-a265-b148450b89e0"],
 " at the vanishing point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"5ec46c9e-d78a-4aac-9d73-5746ff6cb641"],
 " in the image plane."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.668511735562901*^9, 3.6685117944423532`*^9}, {
  3.6685118341641006`*^9, 3.668511836306767*^9}, {3.676063773092009*^9, 
  3.676063797911354*^9}},
 CellID->511268508,ExpressionUUID->"913e7fc7-40c7-4de4-baeb-448154427c68"],

Cell[TextData[{
 "Lasers mounted at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"s"},
      {GridBox[{
         {"0"},
         {"0"}
        }]}
     }], ")"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "2cd3a1a2-b862-40fb-8e34-e9927145d986"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", "s"}]},
      {GridBox[{
         {"0"},
         {"0"}
        }]}
     }], ")"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "950f3543-7fba-425e-a084-333ffc8286ad"],
 " that terminate at ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "da3e6dbf-e7c8-4fd7-be96-e4685c599260"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "coordinates ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "1"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "13335a56-68bf-471c-a080-b926dd669e74"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "2"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "006f3e92-a621-4418-a0db-b19aeaaba48c"],
 " have image plane coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"s", " ", 
      RowBox[{"\[Lambda]", "/", 
       SubscriptBox["z", "1"]}]}], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"d9161b48-5f47-46c0-b655-af014bbb1fae"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"s", " ", 
      RowBox[{"\[Lambda]", "/", 
       SubscriptBox["z", "2"]}]}], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"8dd6d088-4322-44e7-ab4d-4480f4b07ada"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.668512845208393*^9, 3.668513003494721*^9}, {
   3.668513142947875*^9, 3.668513175221686*^9}, {3.675897840992217*^9, 
   3.6758978431631403`*^9}, {3.675897884864429*^9, 3.6758979097770576`*^9}, {
   3.675898127813837*^9, 3.675898136166377*^9}, 3.676046262961464*^9, {
   3.676063820350945*^9, 3.67606383375825*^9}, {3.6761348679866657`*^9, 
   3.676134867986714*^9}},
 CellID->1518531460,ExpressionUUID->"916aa148-0eec-45b2-816f-f89f232f95b2"],

Cell[TextData[{
 "Thus the distance to objects with image plane coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["u", "1"], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"3ff22a59-04a2-49aa-b5ca-e56f5d47c2eb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["u", "2"], ",", "0"}], ")"}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"80252fe7-d1f8-495c-9815-a9aaf1d49450"],
 " gives camera frame coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"s"},
      {GridBox[{
         {"0"},
         {
          RowBox[{"\[Lambda]", "/", 
           SubscriptBox["u", "1"]}]}
        }]}
     }], ")"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "14dfc653-2f9d-4668-9154-5bf2024b8289"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", "s"}]},
      {GridBox[{
         {"0"},
         {
          RowBox[{"\[Lambda]", "/", 
           SubscriptBox["u", "2"]}]}
        }]}
     }], ")"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "532cd1e9-3b21-4efb-bd42-92e720808e92"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.668512845208393*^9, 3.668513003494721*^9}, {
   3.668513142947875*^9, 3.668513321373992*^9}, {3.675897935065276*^9, 
   3.675897935633247*^9}, {3.675898150522168*^9, 3.675898189523718*^9}, 
   3.676046264006631*^9, 3.6761344927561483`*^9, 3.929169594219667*^9},
 CellID->110476205,ExpressionUUID->"dcb515d0-aa84-40aa-b199-3897f9839b6e"],

Cell[TextData[{
 "If both lasers strike the same object, the angle to the object is computed \
as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"arctan", "(", 
    RowBox[{
     RowBox[{"2", "s"}], ",", 
     RowBox[{
      RowBox[{"\[Lambda]", "/", 
       SubscriptBox["u", "1"]}], "-", 
      RowBox[{"\[Lambda]", "/", 
       SubscriptBox["u", "2"]}]}]}], ")"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"db2b56f7-19e3-47bb-93c2-defb0a28e465"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.668512845208393*^9, 3.6685129558848963`*^9}, {
  3.668513303291563*^9, 3.668513348308962*^9}, {3.675893886858984*^9, 
  3.6758938868716784`*^9}, {3.675898214238365*^9, 3.675898269509363*^9}, {
  3.6760638658693323`*^9, 3.6760639321710777`*^9}, {3.676066260655216*^9, 
  3.6760662627242928`*^9}},
 CellID->1019082781,ExpressionUUID->"460f3456-bbbe-40dd-afc8-03a175190fb0"],

Cell["\<\
A camera's reticule (or graticule) is a net of fine lines in the scope. In \
this case, the reticule is aligned with the vanishing point of the lasers. \
The readings on the reticule directly measure the distance from the object to \
the camera.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.668512845208393*^9, 3.6685129558848963`*^9}, {
   3.668513303291563*^9, 3.668513348308962*^9}, {3.675893886858984*^9, 
   3.67589389214741*^9}, {3.675893935509877*^9, 3.6758940405017757`*^9}, 
   3.676046265020598*^9, {3.676063940114781*^9, 3.676063942458571*^9}, {
   3.676066078563311*^9, 3.676066079427032*^9}, {3.676066119897586*^9, 
   3.676066128409285*^9}, {3.676066299803162*^9, 3.67606630141066*^9}, 
   3.676134577155905*^9},
 CellID->1987729175,ExpressionUUID->"7cf3c847-b483-4ab9-8bde-2b40b2761348"]
}, Open  ]],

