 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeDialControl", "[", 
     RowBox[{
      RowBox[{"Dynamic", "[", "pt_", "]"}], ",", "cent_", ",", "color_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
