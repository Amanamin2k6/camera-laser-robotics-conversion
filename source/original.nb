                  RowBox[{"{", 
                   RowBox[{"a", ",", 
                    RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", ",", 
                    RowBox[{"\[Pi]", "/", "32"}]}], "}"}]}], "]"}], ",", 
                "#"}], "]"}], "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]}], ")"}], " ", "&"}]}], "]"}], ",", 
