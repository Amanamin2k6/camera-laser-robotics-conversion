            "Gray", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cent", "+", 
                  RowBox[{".94", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "@", "a"}], ",", 
                    RowBox[{"Sin", "@", "a"}]}], "}"}]}]}], ",", 
                 RowBox[{"cent", "+", 
                  RowBox[{"{", 
